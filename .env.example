# ==============================================================================
# Docker Compose Infrastructure Environment Template (.env)
# Only used by docker-compose.yml for local infrastructure containers.
# (Application configurations live in backend/.env and frontend/.env)
# ==============================================================================

# PostgreSQL (Local Container)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_HOST_PORT=5432

# Redis (Local Container)
REDIS_HOST_PORT=6379

# pgAdmin (Local Container)
PGADMIN_DEFAULT_EMAIL=admin@zenengr.dev
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_HOST_PORT=5050