{
  "$schema": "https://opencode.ai/config.json",

  "instructions": [
    "AGENTS.md"
  ],

  "permission": {
    "bash": {
      "*": "ask",

      "pwd": "allow",
      "ls*": "allow",
      "find*": "allow",
      "grep*": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow"
    },

    "git_*": "allow",
    "postgres_*": "ask",
    "docker_*": "ask",
    "browser_*": "ask",
    "redis_*": "ask",
    "fetch_*": "allow"
  },

  "mcp": {
    "git": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp>=1.2,<2",
        "mcp-server-git"
      ],
      "enabled": true
    },

    "postgres": {
      "type": "local",
      "command": [
        "uvx",
        "--python",
        "3.13",
        "--with",
        "mcp>=1.2,<2",
        "postgres-mcp",
        "postgresql://app:app@localhost:5432/app"
      ],
      "enabled": true
    },

    "redis": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@redis/mcp-server"
      ],
      "environment": {
        "REDIS_URL": "redis://localhost:6379"
      },
      "enabled": true
    },

    "fetch": {
      "type": "local",
      "command": [
        "uvx",
        "--with",
        "mcp>=1.2,<2",
        "mcp-server-fetch"
      ],
      "enabled": true
    },

    "docker": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-server-docker"
      ],
      "enabled": true
    },

    "browser": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
  }
}
