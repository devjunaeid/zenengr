# ==============================================================================
# ZenEngr Backend Environment Configuration Template
# ==============================================================================

# Core Database (PostgreSQL + asyncpg)
# Local Docker: postgresql+asyncpg://app:app@localhost:5432/app
# Remote/Neon:  postgresql+asyncpg://neondb_owner:***@ep-***.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app

# Caching Layer (cashews): "memory" (default in RAM) | "redis"
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# Security / JWT & Superadmin Seed Credentials
JWT_SECRET=dev-only-change-me-secret-key-2026
SEED_SUPERADMIN_EMAIL=admin@zenengr.dev
SEED_SUPERADMIN_PASSWORD=password

# Environment: "local" | "staging" | "production"
ENVIRONMENT=local

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173

# Base URLs
ADMIN_PORTAL_BASE_URL=http://localhost:5173
CLIENT_PORTAL_BASE_URL=http://localhost:5173/client

# Expiry / TTL Settings
INVITE_TTL_HOURS=72
PASSWORD_RESET_TTL_HOURS=24

# File Storage Backend (FEAT-012): "local" | "s3"
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage
UPLOADS_DIR=uploads
FILE_MAX_UPLOAD_MB=25

# S3 Configuration (when STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
